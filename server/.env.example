PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/college_events
JWT_SECRET=change-me-to-a-long-random-string
# Optional: guarantee an admin account exists on startup
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
# Optional: fill an empty database with demo users and events
SEED_DEMO_DATA=true
